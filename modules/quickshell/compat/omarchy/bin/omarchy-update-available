#!/nix/store/pkf547jp8a92k4wmxikkyby58w10pysr-bash-interactive-5.3p9/bin/bash

# omarchy:summary=Check whether Omarchy updates are available.
# omarchy:hidden=true

# Exit 0 means "updates are available" -- the bar widget lights up on it
# (shell/plugins/bar/widgets/SystemUpdate.qml reads the exit code alone).
#
# Upstream answers this by asking pacman and by counting commits behind a git
# checkout of $OMARCHY_PATH. Here $OMARCHY_PATH is a read-only store path with
# no git history and there is no package database to ask, so neither question
# can be answered.
#
# Reporting "an update is available" unconditionally would light the widget
# permanently; the honest answer is that this cannot be determined without
# evaluating the flake, which is far too expensive for something the bar polls.
# A NixOS host updates when its owner runs `omarchy update`.
exit 1
