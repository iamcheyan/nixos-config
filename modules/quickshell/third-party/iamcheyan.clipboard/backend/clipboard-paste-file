#!/usr/bin/env bash
set -euo pipefail
copy_only=false
if [[ ${1:-} == --copy-only ]]; then copy_only=true; shift; fi
mime="${1:-}"
path="${2:-}"
[[ -n "$mime" && -r "$path" ]] || exit 1
wl-copy --type "$mime" <"$path"
if [[ "$copy_only" != true ]]; then
  sleep 0.15
  wtype -M shift -k Insert -m shift 2>/dev/null || true
fi
