#!/bin/sh
set -eu

desktop_id="${1:-}"
entry_name="${2:-$desktop_id}"
[ -n "$desktop_id" ] || exit 2

case "$desktop_id" in
  *.desktop) desktop_file_name="$desktop_id" ;;
  *) desktop_file_name="$desktop_id.desktop" ;;
esac

user_data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
desktop_file="$user_data_home/applications/$desktop_file_name"
if [ ! -f "$desktop_file" ]; then
  echo "$entry_name comes from a system package; remove it using its package manager." >&2
  exit 1
fi

rm -f -- "$desktop_file"
if command -v update-desktop-database >/dev/null 2>&1; then
  update-desktop-database "$(dirname -- "$desktop_file")" >/dev/null 2>&1 || true
fi
