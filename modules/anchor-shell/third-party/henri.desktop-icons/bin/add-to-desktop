#!/usr/bin/env python3
"""Create Windows-style shortcuts, or copy files, onto the Desktop."""

from __future__ import annotations

import argparse
import os
import shutil
import sys
from pathlib import Path

import gi

gi.require_version("Gio", "2.0")
from gi.repository import Gio, GLib

_BIN_DIR = str(Path(__file__).resolve().parent)
if _BIN_DIR not in sys.path:
    sys.path.insert(0, _BIN_DIR)

from common import (
    desktop_dir,
    guess_icon,
    is_trusted_application_source,
    unique_dest,
)

INVALID_FILENAME = r'/\0<>:"\\|?*'


def notify(title: str, message: str, error: bool = False) -> None:
    try:
        Gio.Subprocess.new(
            [
                "notify-send",
                "-u",
                "normal" if error else "low",
                "-i",
                "dialog-error" if error else "user-desktop",
                title,
                message,
            ],
            Gio.SubprocessFlags.NONE,
        )
    except Exception:
        print(f"{title}: {message}", file=sys.stderr)


def sanitize_name(name: str) -> str:
    name = name.strip().strip(".")
    for ch in INVALID_FILENAME:
        name = name.replace(ch, " ")
    name = " ".join(name.split())
    return name or "Shortcut"


def unique_path(directory: Path, name: str, suffix: str) -> Path:
    base = sanitize_name(name)
    if suffix and base.lower().endswith(suffix.lower()):
        base = base[: -len(suffix)]
    return unique_dest(directory, f"{base}{suffix}")


def file_uri(path: Path) -> str:
    return path.resolve().as_uri()


def trust_desktop_file(path: Path) -> None:
    try:
        path.chmod(path.stat().st_mode | 0o111)
    except OSError:
        pass
    try:
        Gio.Subprocess.new(
            ["gio", "set", str(path), "metadata::trusted", "true"],
            Gio.SubprocessFlags.STDOUT_SILENCE | Gio.SubprocessFlags.STDERR_SILENCE,
        )
    except Exception:
        pass


def read_desktop_name(path: Path) -> str | None:
    try:
        keyfile = GLib.KeyFile()
        keyfile.load_from_file(str(path), GLib.KeyFileFlags.NONE)
        return keyfile.get_string("Desktop Entry", "Name")
    except GLib.Error:
        return None


def write_link_desktop(dest: Path, name: str, target: Path) -> None:
    icon = guess_icon(target)
    content = (
        "[Desktop Entry]\n"
        "Type=Link\n"
        f"Name={name}\n"
        f"URL={file_uri(target)}\n"
        f"Icon={icon}\n"
    )
    dest.write_text(content, encoding="utf-8")
    trust_desktop_file(dest)


def add_shortcut(source: Path, desktop: Path) -> Path:
    source = source.expanduser().resolve()
    if not source.exists():
        raise FileNotFoundError(f"Path not found: {source}")

    if source == desktop or source.parent == desktop:
        raise ValueError(f"Already on the Desktop: {source.name}")

    suffix = source.suffix.lower()
    if suffix == ".desktop":
        name = read_desktop_name(source) or source.stem
        dest = unique_path(desktop, name, ".desktop")
        shutil.copy2(source, dest)
        if is_trusted_application_source(source):
            trust_desktop_file(dest)
        return dest

    if suffix == ".url":
        dest = unique_path(desktop, source.stem, ".url")
        shutil.copy2(source, dest)
        return dest

    dest = unique_path(desktop, source.name, ".desktop")
    write_link_desktop(dest, source.name, source)
    return dest


def copy_one(source: Path, desktop: Path) -> Path:
    source = source.expanduser().resolve()
    if not source.exists():
        raise FileNotFoundError(f"Path not found: {source}")
    if source == desktop:
        raise ValueError("Cannot copy the Desktop folder onto itself")
    if source.parent == desktop:
        raise ValueError(f"Already on the Desktop: {source.name}")

    dest = unique_dest(desktop, source.name)
    if source.is_dir():
        shutil.copytree(source, dest)
    else:
        shutil.copy2(source, dest)
        if dest.suffix.lower() == ".desktop" and is_trusted_application_source(source):
            trust_desktop_file(dest)
    return dest


def pick_paths(title: str, initial: Path) -> list[str]:
    gi.require_version("Gtk", "4.0")
    gi.require_version("Adw", "1")
    from gi.repository import Adw, Gtk

    chosen: list[str] = []

    class App(Adw.Application):
        def __init__(self):
            super().__init__(application_id="org.omarchy.add-to-desktop")
            self.connect("activate", self.on_activate)

        def on_activate(self, _app) -> None:
            win = Gtk.ApplicationWindow(application=self)
            win.set_default_size(1, 1)
            dialog = Gtk.FileDialog(title=title)
            dialog.set_initial_folder(Gio.File.new_for_path(str(initial)))
            dialog.open_multiple(win, None, self._on_picked)

        def _on_picked(self, dialog, result) -> None:
            try:
                files = dialog.open_multiple_finish(result)
            except GLib.Error:
                self.quit()
                return
            if files:
                for i in range(files.get_n_items()):
                    item = files.get_item(i)
                    path = item.get_path() if item else None
                    if path:
                        chosen.append(path)
            self.quit()

    App().run([])
    return chosen


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        description="Create shortcuts on the Desktop, or copy files there."
    )
    parser.add_argument(
        "paths",
        nargs="*",
        help="Files, folders, or application launchers to pin.",
    )
    parser.add_argument(
        "--copy",
        action="store_true",
        help="Copy the real files onto the Desktop instead of creating shortcuts.",
    )
    parser.add_argument(
        "--pick-app",
        action="store_true",
        help="Pick application launchers to pin.",
    )
    parser.add_argument(
        "--pick-files",
        action="store_true",
        help="Pick files to copy onto the Desktop.",
    )
    args = parser.parse_args(argv)

    desktop = desktop_dir()
    paths = list(args.paths)
    copy = args.copy

    if args.pick_app:
        paths.extend(
            pick_paths("Pin application to Desktop", Path("/usr/share/applications"))
        )
    if args.pick_files:
        copy = True
        paths.extend(pick_paths("Add files to Desktop", Path.home()))

    if not paths:
        return 0

    created: list[Path] = []
    errors: list[str] = []
    for raw in paths:
        try:
            if copy:
                created.append(copy_one(Path(raw), desktop))
            else:
                created.append(add_shortcut(Path(raw), desktop))
        except Exception as error:
            errors.append(str(error))

    for p in created:
        print(p)
    if created:
        noun = "file" if copy else "shortcut"
        if len(created) == 1:
            notify("Desktop", f"Added {noun}: {created[0].name}")
        else:
            notify("Desktop", f"Added {len(created)} {noun}s")
    if errors:
        notify("Desktop", errors[0], error=True)
        return 1
    return 0 if created else 1


if __name__ == "__main__":
    sys.exit(main())
