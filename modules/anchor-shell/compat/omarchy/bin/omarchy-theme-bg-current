#!/nix/store/pkf547jp8a92k4wmxikkyby58w10pysr-bash-interactive-5.3p9/bin/bash

# omarchy:summary=Show current background
# omarchy:examples=omarchy theme bg current

. "${OMARCHY_PATH:-.}/bin/omarchy-paths"
BACKGROUND_PATH=$(readlink -f "$ANCHOR_SHELL_STATE_DIR/current/background" 2>/dev/null)

if [[ -n $BACKGROUND_PATH ]]; then
  basename -- "$BACKGROUND_PATH" | perl -pe 's/\.[^.]+$//; s/^\d+-//; s/-/ /g; s/\b(\w)/\U$1/g'
else
  echo "Unknown"
fi
