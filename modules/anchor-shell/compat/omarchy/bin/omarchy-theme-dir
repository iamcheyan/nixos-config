#!/nix/store/pkf547jp8a92k4wmxikkyby58w10pysr-bash-interactive-5.3p9/bin/bash

# omarchy:summary=Print the directory holding a theme, preferring a user-installed copy
# omarchy:args=<theme-name>
# omarchy:examples=omarchy theme dir tokyo-night

theme="${1:-}"
. "${OMARCHY_PATH:-.}/bin/omarchy-paths"

if [[ -z $theme ]]; then
  echo "Usage: omarchy-theme-dir <theme-name>" >&2
  exit 1
fi

if [[ -d $ANCHOR_SHELL_CONFIG_DIR/themes/$theme ]]; then
  echo "$ANCHOR_SHELL_CONFIG_DIR/themes/$theme"
else
  echo "$OMARCHY_PATH/themes/$theme"
fi
