#!/nix/store/pkf547jp8a92k4wmxikkyby58w10pysr-bash-interactive-5.3p9/bin/bash

# omarchy:summary=Show current theme
# omarchy:examples=omarchy theme current

. "${OMARCHY_PATH:-.}/bin/omarchy-paths"
THEME_NAME_PATH="$ANCHOR_SHELL_STATE_DIR/current/theme.name"

if [[ -f $THEME_NAME_PATH ]]; then
  sed -E 's/(^|-)([a-z])/\1\u\2/g; s/-/ /g' "$THEME_NAME_PATH"
else
  echo "Unknown"
fi
