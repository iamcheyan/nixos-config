#!/nix/store/pkf547jp8a92k4wmxikkyby58w10pysr-bash-interactive-5.3p9/bin/bash

# omarchy:summary=Refresh the SDDM login theme

# Upstream removes and re-copies the theme into /usr/share/sddm/themes with
# sudo. Here it lives in the package, at share/sddm/themes/omarchy, and
# services.displayManager.sddm.theme names it -- so there is nothing to copy
# and nowhere to copy it to.
cat <<'MSG'
The login theme is declared on NixOS, not refreshed.

  It ships inside the nixarchy package and is already selected:

    services.displayManager.sddm.theme = "omarchy";

  It changes when the system does:

    sudo nixos-rebuild switch --flake <your-flake>

  If another display manager greets you, set
  programs.nixarchy.displayManager = false and this does not apply at all.
MSG
