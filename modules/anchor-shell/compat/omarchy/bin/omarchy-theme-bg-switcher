#!/nix/store/pkf547jp8a92k4wmxikkyby58w10pysr-bash-interactive-5.3p9/bin/bash

# omarchy:summary=Open the Omarchy background switcher
# omarchy:group=theme
# omarchy:name=bg-switcher
# omarchy:aliases=omarchy background

. "${OMARCHY_PATH:-.}/bin/omarchy-paths"
theme_name=$(cat "$ANCHOR_SHELL_STATE_DIR/current/theme.name" 2>/dev/null)
current_background=$(readlink -f "$ANCHOR_SHELL_STATE_DIR/current/background" 2>/dev/null)

omarchy-menu-images \
  --selected "$current_background" \
  "$ANCHOR_SHELL_STATE_DIR/current/theme/backgrounds" \
  "$ANCHOR_SHELL_CONFIG_DIR/backgrounds/$theme_name"
