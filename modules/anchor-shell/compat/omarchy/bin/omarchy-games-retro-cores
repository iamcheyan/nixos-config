#!/nix/store/pkf547jp8a92k4wmxikkyby58w10pysr-bash-interactive-5.3p9/bin/bash

# omarchy:summary=List installed RetroArch core names

# Upstream filters a hardcoded list of 23 preferred cores against
# /usr/lib/libretro. On NixOS the installed cores are whatever
# programs.nixarchy.apps.retroarch.package was built with, so filtering
# against a fixed list would hide any core outside it. List what is actually
# there instead, and take the labels from libretro-core-info -- the same
# metadata RetroArch's own UI uses -- rather than restating them here.
set -e

core_dir=$(omarchy-retroarch-cores 2>/dev/null) || exit 0
[[ -d $core_dir ]] || exit 0

# Substituted at build time: the same libretro-core-info RetroArch's own
# wrapper points at.
info_dir=/nix/store/6lh6yjmpvynwk6nhi1v9x3k61gxbfald-libretro-core-info-1.22.2/share/retroarch/cores

for so in "$core_dir"/*_libretro.so; do
  [[ -e $so ]] || continue
  core=$(basename "$so" _libretro.so)
  label=""
  if [[ -n $info_dir && -f "$info_dir/${core}_libretro.info" ]]; then
    label=$(sed -n 's/^display_name = "\(.*\)"$/\1/p' \
      "$info_dir/${core}_libretro.info" | head -1)
  fi
  printf '%s (%s)\n' "${label:-$core}" "$core"
done | sort
