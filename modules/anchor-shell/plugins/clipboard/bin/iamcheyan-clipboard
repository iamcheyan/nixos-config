#!/usr/bin/env bash
set -euo pipefail

action="${1:-toggle-at-bar}"
bar_height="${2:-32}"
plugin_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

case "$action" in
  toggle|toggle-at-bar|open|open-at-bar|toggle-at-cursor|open-at-cursor) ;;
  *) echo "usage: iamcheyan-clipboard [toggle|toggle-at-bar|open|open-at-bar|toggle-at-cursor|open-at-cursor] [bar-height]" >&2; exit 2 ;;
esac

config_path="$plugin_dir/apps/iamcheyan-clipboard/shell.qml"
existing_pid="$(ps -eo pid=,comm=,args= | awk -v config="$config_path" '$2 ~ /quickshell/ && index($0, config) { print $1; exit }')"
if [[ -n "$existing_pid" ]]; then
  case "$action" in
    open|open-at-cursor|open-at-bar) ipc_function="open" ;;
    *) ipc_function="toggle" ;;
  esac
  if timeout 2s qs ipc --pid "$existing_pid" call clipboard "$ipc_function" >/dev/null 2>&1; then
    exit 0
  fi
fi

position="bar"
if [[ "$action" == *-at-cursor ]]; then
  position="cursor"
fi

exec env \
  HANCORE_CLIPBOARD_ON_DEMAND=1 \
  HANCORE_CLIPBOARD_POSITION="$position" \
  HANCORE_CLIPBOARD_BAR_HEIGHT="$bar_height" \
  qs --no-duplicate -p "$config_path"
