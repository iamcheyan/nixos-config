#!/usr/bin/env bash
set -euo pipefail
shift_insert=false
copy_only=false
history_index=""
while (($#)); do
  case "$1" in
    --shift-insert) shift_insert=true; shift ;;
    --copy-only) copy_only=true; shift ;;
    --history-index) history_index="${2:-}"; shift 2 ;;
    *) break ;;
  esac
done
history_path="${XDG_STATE_HOME:-$HOME/.local/state}/labwc/clipboard-history.json"
if [[ -n "$history_index" ]]; then
  [[ "$history_index" =~ ^[0-9]+$ ]] || exit 1
  jq -e --argjson index "$history_index" '.[$index].type == "text" and (.[$index].text | type == "string")' "$history_path" >/dev/null
  jq -j --argjson index "$history_index" '.[$index].text' "$history_path" | wl-copy
else
  text="${1:-}"
  [[ -n "$text" ]] || exit 1
  printf '%s' "$text" | wl-copy
fi
[[ "$copy_only" == true ]] && exit 0
sleep 0.15
if [[ "$shift_insert" == true ]]; then wtype -M shift -k Insert -m shift 2>/dev/null || true
else wtype -- "${text:-}" 2>/dev/null || true
fi
