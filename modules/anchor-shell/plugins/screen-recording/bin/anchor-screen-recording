#!/usr/bin/env bash
set -euo pipefail

runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
pid_file="$runtime_dir/anchor-screen-recording.pid"
output_file="$runtime_dir/anchor-screen-recording.output"
log_file="${ANCHOR_SCREEN_RECORD_LOG:-$runtime_dir/anchor-screen-recording.log}"

mode="region"
output_name=""
region_geom=""
with_sound=0
quiet=0

notify() {
  [[ "$quiet" -eq 1 ]] && return 0
  command -v notify-send >/dev/null 2>&1 || return 0
  notify-send -a "Anchor Shell" "$1" "$2" 2>/dev/null || true
}

process_alive() {
  local pid="$1" state
  kill -0 "$pid" 2>/dev/null || return 1
  state="$(ps -o stat= -p "$pid" 2>/dev/null | tr -d ' ' || true)"
  [[ -n "$state" && "$state" != Z* ]]
}

recorder_pid() {
  local pid exe
  [[ -r "$pid_file" ]] || return 1
  pid="$(cat "$pid_file" 2>/dev/null || true)"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  process_alive "$pid" || return 1
  exe="$(readlink "/proc/$pid/exe" 2>/dev/null || true)"
  case "$exe" in
    */wf-recorder|*/gpu-screen-recorder) printf '%s\n' "$pid" ;;
    *) return 1 ;;
  esac
}

backend() {
  if command -v gpu-screen-recorder >/dev/null 2>&1; then
    printf 'gpu-screen-recorder\n'
    return 0
  fi
  if command -v wf-recorder >/dev/null 2>&1; then
    printf 'wf-recorder\n'
    return 0
  fi
  return 1
}

list_monitors() {
  if command -v gpu-screen-recorder >/dev/null 2>&1; then
    gpu-screen-recorder --list-monitors 2>/dev/null | awk -F'|' 'NF { print $1 }'
    return 0
  fi
  if command -v wlr-randr >/dev/null 2>&1; then
    wlr-randr 2>/dev/null | awk '/^[A-Za-z0-9-]+ / { print $1 }'
    return 0
  fi
  return 1
}

monitor_exists() {
  local wanted="$1" name
  [[ -n "$wanted" ]] || return 1
  while IFS= read -r name; do
    [[ "$name" == "$wanted" ]] && return 0
  done < <(list_monitors)
  return 1
}

only_monitor() {
  local names=() name
  while IFS= read -r name; do
    [[ -n "$name" ]] && names+=("$name")
  done < <(list_monitors)
  if [[ ${#names[@]} -eq 1 ]]; then
    printf '%s\n' "${names[0]}"
    return 0
  fi
  return 1
}

videos_dir() {
  if [[ -n "${ANCHOR_SCREEN_RECORD_DIR:-}" ]]; then
    printf '%s\n' "$ANCHOR_SCREEN_RECORD_DIR"
    return
  fi

  if [[ -r "${XDG_CONFIG_HOME:-$HOME/.config}/user-dirs.dirs" ]]; then
    # user-dirs.dirs is generated locally by xdg-user-dirs.
    # shellcheck disable=SC1090
    source "${XDG_CONFIG_HOME:-$HOME/.config}/user-dirs.dirs"
  fi
  printf '%s\n' "${XDG_VIDEOS_DIR:-$HOME/Videos}"
}

recording_status() {
  if recorder_pid >/dev/null; then
    printf 'recording\n'
    return 0
  fi
  rm -f "$pid_file" "$output_file"
  printf 'idle\n'
}

pause_recording() {
  local pid
  pid="$(recorder_pid || true)"
  if [[ -z "$pid" ]]; then
    echo "anchor-screen-recording: nothing is recording" >&2
    return 1
  fi
  kill -USR2 "$pid" 2>/dev/null || return 1
}

stop_recording() {
  local pid output
  pid="$(recorder_pid || true)"
  if [[ -z "$pid" ]]; then
    rm -f "$pid_file" "$output_file"
    notify "Screen recording" "No active recording was found."
    return 1
  fi
  output="$(cat "$output_file" 2>/dev/null || true)"
  kill -INT "$pid" 2>/dev/null || true
  while process_alive "$pid"; do sleep 0.1; done
  rm -f "$pid_file" "$output_file"

  if [[ -n "$output" && -s "$output" ]]; then
    notify "Recording saved" "$output"
    printf '%s\n' "$output"
    return 0
  fi
  notify "Screen recording" "No output file was found."
  return 1
}

start_recording() {
  local be output geometry x y width height
  local -a command

  if recorder_pid >/dev/null; then
    notify "Screen recording" "A recording is already in progress."
    return 1
  fi

  if ! be="$(backend)"; then
    notify "Screen recording unavailable" "Install gpu-screen-recorder or wf-recorder."
    return 1
  fi

  geometry="$region_geom"
  if [[ "$mode" == "region" ]]; then
    [[ -n "$geometry" ]] || {
      notify "Screen recording" "No region was provided."
      return 1
    }
  else
    if [[ -z "$output_name" ]]; then
      output_name="$(only_monitor || true)"
    fi
    if [[ -z "$output_name" ]] || ! monitor_exists "$output_name"; then
      notify "Screen recording" "Could not resolve which display to record."
      return 1
    fi
  fi

  mkdir -p "$(videos_dir)"
  output="$(videos_dir)/screenrecording-$(date '+%Y-%m-%d_%H-%M-%S')-$$.mp4"

  if [[ "$be" == "gpu-screen-recorder" ]]; then
    command=(gpu-screen-recorder -k auto -f 60 -fm cfr -fallback-cpu-encoding yes -s 0x0 -o "$output")
    if [[ -n "$geometry" ]]; then
      if [[ "$geometry" =~ ^(-?[0-9]+),(-?[0-9]+)[[:space:]]([0-9]+)x([0-9]+)$ ]]; then
        x="${BASH_REMATCH[1]}"
        y="${BASH_REMATCH[2]}"
        width="${BASH_REMATCH[3]}"
        height="${BASH_REMATCH[4]}"
        command+=(-w region -region "${width}x${height}+${x}+${y}")
      else
        notify "Screen recording failed" "Invalid geometry: $geometry"
        return 1
      fi
    else
      command+=(-w "$output_name")
    fi
    if [[ "$with_sound" -eq 1 ]]; then
      command+=(-a default_output -ac aac)
    fi
  else
    command=(wf-recorder -f "$output")
    if [[ -n "$geometry" ]]; then
      command+=(-g "$geometry")
    else
      command+=(-o "$output_name")
    fi
    [[ "$with_sound" -eq 1 ]] && command+=(-a)
  fi

  {
    printf '\n===== %s (%s) mode=%s output=%s region=%s =====\n' \
      "$(date '+%F %T')" "$be" "$mode" "${output_name:-}" "${geometry:-}"
  } >>"$log_file"
  (
    trap - INT
    exec "${command[@]}"
  ) >>"$log_file" 2>&1 </dev/null &
  local pid=$!

  sleep 0.35
  if ! process_alive "$pid"; then
    [[ ! -e "$output" || -s "$output" ]] || rm -f "$output"
    notify "Screen recording failed" "The recorder exited during startup. Log: $log_file"
    return 1
  fi

  local pid_tmp="$pid_file.$$"
  printf '%s\n' "$pid" >"$pid_tmp"
  mv -f "$pid_tmp" "$pid_file"
  printf '%s\n' "$output" >"$output_file"
  printf '%s\n' "$output"
  notify "Recording started" "$output"
}

parse_start_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --region)
        mode="region"
        if [[ $# -ge 2 && "$2" != --* ]]; then
          region_geom="$2"
          shift
        fi
        ;;
      --region=*)
        mode="region"
        region_geom="${1#--region=}"
        ;;
      --fullscreen|-f) mode="fullscreen" ;;
      --output)
        shift
        output_name="${1:-}"
        ;;
      --output=*) output_name="${1#--output=}" ;;
      --sound|-a|--with-desktop-audio) with_sound=1 ;;
      --quiet|-q) quiet=1 ;;
      *)
        echo "anchor-screen-recording: unknown start option '$1'" >&2
        return 2
        ;;
    esac
    shift || true
  done
}

usage() {
  cat <<'USAGE'
Usage: anchor-screen-recording <status|start|stop|pause|toggle> [options]

  start --region "X,Y WxH"       Record the given compositor region
  start --fullscreen --output N  Record display N
  start --fullscreen             Record the only connected display
  pause                          Toggle pause on the running recorder
  stop                           Finish the current recording
  status                         Print recording or idle
USAGE
}

case "${1:-toggle}" in
  status)
    recording_status
    ;;
  start)
    shift || true
    parse_start_args "$@"
    start_recording
    ;;
  pause|--pause)
    pause_recording
    ;;
  stop|--stop)
    stop_recording
    ;;
  toggle)
    shift || true
    if recorder_pid >/dev/null; then
      stop_recording
    else
      parse_start_args "$@"
      start_recording
    fi
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    echo "anchor-screen-recording: unknown command '$1'" >&2
    usage >&2
    exit 2
    ;;
esac
