#!/usr/bin/env bash
set -euo pipefail

runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
pid_file="$runtime_dir/anchor-screen-recording.pid"
output_file="$runtime_dir/anchor-screen-recording.output"
log_file="${ANCHOR_SCREEN_RECORD_LOG:-$runtime_dir/anchor-screen-recording.log}"

notify() {
  command -v notify-send >/dev/null 2>&1 || return 0
  notify-send -a "Anchor Shell" "$1" "$2" 2>/dev/null || true
}

process_alive() {
  local pid="$1" state
  kill -0 "$pid" 2>/dev/null || return 1
  state="$(ps -o stat= -p "$pid" 2>/dev/null | tr -d ' ' || true)"
  [[ -n "$state" && "$state" != Z* ]]
}

recorder_pid() {
  local pid exe
  [[ -r "$pid_file" ]] || return 1
  pid="$(cat "$pid_file" 2>/dev/null || true)"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  process_alive "$pid" || return 1
  exe="$(readlink "/proc/$pid/exe" 2>/dev/null || true)"
  case "$exe" in
    */wf-recorder|*/gpu-screen-recorder) printf '%s\n' "$pid" ;;
    *) return 1 ;;
  esac
}

recording_status() {
  if recorder_pid >/dev/null; then
    printf 'yes\n'
  else
    rm -f "$pid_file" "$output_file"
    printf 'no\n'
  fi
}

videos_dir() {
  if [[ -n "${ANCHOR_SCREEN_RECORD_DIR:-}" ]]; then
    printf '%s\n' "$ANCHOR_SCREEN_RECORD_DIR"
    return
  fi

  if [[ -r "${XDG_CONFIG_HOME:-$HOME/.config}/user-dirs.dirs" ]]; then
    # user-dirs.dirs is generated locally by xdg-user-dirs.
    # shellcheck disable=SC1090
    source "${XDG_CONFIG_HOME:-$HOME/.config}/user-dirs.dirs"
  fi
  printf '%s\n' "${XDG_VIDEOS_DIR:-$HOME/Videos}"
}

stop_recording() {
  local pid output
  pid="$(recorder_pid || true)"
  if [[ -z "$pid" ]]; then
    rm -f "$pid_file" "$output_file"
    notify "Screen recording" "No active recording was found."
    return 1
  fi
  output="$(cat "$output_file" 2>/dev/null || true)"
  kill -INT "$pid" 2>/dev/null || true
  # SIGINT lets both backends write the MP4 trailer before exiting.
  while process_alive "$pid"; do sleep 0.1; done
  rm -f "$pid_file" "$output_file"

  if [[ -n "$output" && -s "$output" ]]; then
    notify "Recording saved" "$output"
    printf '%s\n' "$output"
    return 0
  fi
  notify "Screen recording" "No active recording was found."
  return 1
}

start_recording() {
  local backend output geometry x y width height
  local -a command

  if recorder_pid >/dev/null; then
    notify "Screen recording" "A recording is already in progress."
    return 1
  fi

  if command -v wf-recorder >/dev/null 2>&1; then
    backend="wf-recorder"
  elif command -v gpu-screen-recorder >/dev/null 2>&1; then
    backend="gpu-screen-recorder"
  else
    notify "Screen recording unavailable" "Install wf-recorder or gpu-screen-recorder."
    return 1
  fi

  command -v slurp >/dev/null 2>&1 || {
    notify "Screen recording unavailable" "slurp is required to select a region."
    return 1
  }

  notify "Select a screen area" "Click and drag to choose what to record. Press Esc to cancel."
  geometry="$(slurp -d -b '#00000066' -c '#f4f4f4ff' -s '#ffffff22' -w 2 2>/dev/null)" || {
    notify "Screen recording" "Selection cancelled."
    return 0
  }
  [[ -n "$geometry" ]] || return 0

  mkdir -p "$(videos_dir)"
  output="$(videos_dir)/screenrecording-$(date '+%Y-%m-%d_%H-%M-%S')-$$.mp4"

  if [[ "$backend" == "wf-recorder" ]]; then
    command=(wf-recorder -f "$output" -g "$geometry")
    [[ "${1:-}" == "--sound" ]] && command+=(-a)
  else
    if [[ "$geometry" =~ ^(-?[0-9]+),(-?[0-9]+)[[:space:]]([0-9]+)x([0-9]+)$ ]]; then
      x="${BASH_REMATCH[1]}"
      y="${BASH_REMATCH[2]}"
      width="${BASH_REMATCH[3]}"
      height="${BASH_REMATCH[4]}"
      command=(gpu-screen-recorder -w "${width}x${height}+${x}+${y}" -k auto -f 60 -fm cfr -fallback-cpu-encoding yes -o "$output")
      if [[ "${1:-}" == "--sound" ]]; then
        command+=(-a default_output -ac aac)
      fi
    else
      notify "Screen recording failed" "slurp returned invalid geometry: $geometry"
      return 1
    fi
  fi

  {
    printf '\n===== %s (%s) region %s =====\n' "$(date '+%F %T')" "$backend" "$geometry"
  } >>"$log_file"
  (
    trap - INT
    exec "${command[@]}"
  ) >>"$log_file" 2>&1 </dev/null &
  local pid=$!

  sleep 0.35
  if ! process_alive "$pid"; then
    [[ ! -e "$output" || -s "$output" ]] || rm -f "$output"
    notify "Screen recording failed" "The recorder exited during startup. Log: $log_file"
    return 1
  fi

  local pid_tmp="$pid_file.$$"
  printf '%s\n' "$pid" >"$pid_tmp"
  mv -f "$pid_tmp" "$pid_file"
  printf '%s\n' "$output" >"$output_file"
  notify "Recording started" "$output"
}

case "${1:-toggle}" in
  status)
    recording_status
    ;;
  start)
    shift || true
    start_recording "${1:-}"
    ;;
  stop|--stop)
    stop_recording
    ;;
  toggle)
    if recorder_pid >/dev/null; then stop_recording; else start_recording "${2:-}"; fi
    ;;
  -h|--help|help)
    cat <<'USAGE'
Usage: anchor-screen-recording [start [--sound] | stop | status | toggle]

Starting opens slurp to select a region, then records to the Videos directory.
USAGE
    ;;
  *)
    echo "anchor-screen-recording: unknown command '$1'" >&2
    exit 2
    ;;
esac
