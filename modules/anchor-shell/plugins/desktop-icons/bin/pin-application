#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 || -z $1 ]]; then
  printf 'Usage: pin-application DESKTOP-ID\n' >&2
  exit 2
fi

desktop_id=$1
if [[ $desktop_id == */* || $desktop_id == *\\* ]]; then
  printf 'Invalid desktop ID: %s\n' "$1" >&2
  exit 2
fi

data_home=${XDG_DATA_HOME:-$HOME/.local/share}
data_dirs="$data_home"
if [[ -n ${XDG_DATA_DIRS:-} ]]; then
  data_dirs+=" ${XDG_DATA_DIRS//:/ }"
else
  data_dirs+=" /usr/local/share /usr/share"
fi

for data_dir in $data_dirs; do
  # DesktopEntries IDs omit the final filename extension. Preserve IDs that
  # themselves end in `.desktop` (for example `org.telegram.desktop`) and
  # append the filename extension instead of stripping part of the ID.
  candidate=$data_dir/applications/$desktop_id.desktop
  if [[ -f $candidate ]]; then
    exec add-to-desktop "$candidate"
  fi

  # Also accept callers that pass an actual desktop filename.
  if [[ $desktop_id == *.desktop ]]; then
    candidate=$data_dir/applications/$desktop_id
    if [[ -f $candidate ]]; then
      exec add-to-desktop "$candidate"
    fi
  fi
done

printf 'Application not found: %s\n' "$desktop_id" >&2
notify-send -u normal -i dialog-error "Desktop" "Application not found: $desktop_id" 2>/dev/null || true
exit 1
