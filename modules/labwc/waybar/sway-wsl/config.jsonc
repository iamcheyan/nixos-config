// -*- mode: jsonc -*-
{
    "height": 25,
    "spacing": 0,
    "modules-left": [
        "sway/workspaces",
        "sway/window"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
    ],
    "sway/window": {
        "format": "{}",
        "max-length": 50,
        "separate-outputs": true
    },
    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{icon}",
        "format-icons": {
            "focused": "",
            "default": "",
            "urgent": ""
        }
    },
    "clock": {
        "format": "{:%Y-%m-%d %H:%M}",
        "tooltip-format": "{:%Y-%m-%d}"
    }
}
