#!/bin/sh
set -eu

qs_bin=""
for candidate in \
    "$HOME/.local/bin/quickshell" \
    "$HOME/.local/bin/qs" \
    "$(command -v quickshell 2>/dev/null || true)" \
    "$(command -v qs 2>/dev/null || true)"; do
    if [ -n "$candidate" ] && [ -x "$candidate" ]; then
        qs_bin="$candidate"
        break
    fi
done

if [ -z "$qs_bin" ]; then
    printf 'Quickshell executable not found\n' >&2
    exit 127
fi

anchor_config_dir="${ANCHOR_SHELL_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/anchor-shell}"
legacy_config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell"
config_dir="${QUICKSHELL_ROOT:-${XDG_CONFIG_HOME:-$HOME/.config}/quickshell}"
mode_file="$anchor_config_dir/mode"
runtime_file="$anchor_config_dir/runtime"
[ -r "$mode_file" ] || mode_file="$legacy_config_dir/mode"
[ -r "$runtime_file" ] || runtime_file="$legacy_config_dir/runtime"
mkdir -p "$anchor_config_dir" "${ANCHOR_SHELL_PLUGINS_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/anchor-shell/plugins}"
if [ ! -e "$anchor_config_dir/shell.json" ] && [ -f "$legacy_config_dir/shell.json" ]; then
    cp "$legacy_config_dir/shell.json" "$anchor_config_dir/shell.json"
fi
if [ -r "$mode_file" ] && [ "$(cat "$mode_file")" = dev ] \
    && [ -f /home/tetsuya/nixos-config/modules/anchor-shell/shell.qml ]; then
    config_dir=/home/tetsuya/nixos-config/modules/anchor-shell
fi
export QUICKSHELL_ROOT="$config_dir"
export ANCHOR_SHELL_CONFIG_DIR="$anchor_config_dir"
export ANCHOR_SHELL_STATE_DIR="${ANCHOR_SHELL_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/anchor-shell}"
export ANCHOR_SHELL_PLUGINS_DIR="${ANCHOR_SHELL_PLUGINS_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/anchor-shell/plugins}"
export QUICKSHELL_PLUGINS_DIR="$ANCHOR_SHELL_PLUGINS_DIR"
export QUICKSHELL_CONFIG="${QUICKSHELL_CONFIG:-$anchor_config_dir/shell.json}"
export QT_QUICK_CONTROLS_STYLE="${QT_QUICK_CONTROLS_STYLE:-Basic}"
export QML2_IMPORT_PATH="/run/current-system/sw/lib/qt-6/qml${QML2_IMPORT_PATH:+:$QML2_IMPORT_PATH}"
export QML_IMPORT_PATH="/run/current-system/sw/lib/qt-6/qml${QML_IMPORT_PATH:+:$QML_IMPORT_PATH}"

# Labwc's autostart provides the isolated Python environment used by the
# desktop-icons helper.  Reloads are often launched from a terminal instead
# of the session autostart, so recover the same value when it is not inherited.
if [ -z "${ANCHOR_SHELL_PYTHON:-}" ] && [ -r "$HOME/.config/labwc/autostart" ]; then
    anchor_shell_python=$(sed -n 's/.*ANCHOR_SHELL_PYTHON="\([^"]*\)".*/\1/p' \
        "$HOME/.config/labwc/autostart" | head -1)
    if [ -n "$anchor_shell_python" ]; then
        export ANCHOR_SHELL_PYTHON="$anchor_shell_python"
    fi
fi

# The compatibility runtime keeps the historical Omarchy names while the
# source is migrated into this repository.  Legacy remains the default until
# the copied runtime has been verified in the running session.
omarchy_root="${NIXARCHY_ROOT:-${OMARCHY_PATH:-}}"
if [ -r "$runtime_file" ] && [ "$(cat "$runtime_file")" = compat ]; then
    omarchy_root="${QUICKSHELL_OMARCHY_COMPAT_ROOT:-$config_dir/compat/omarchy}"
elif [ -n "${QUICKSHELL_OMARCHY_LEGACY_ROOT:-}" ]; then
    omarchy_root="$QUICKSHELL_OMARCHY_LEGACY_ROOT"
fi
if [ -n "$omarchy_root" ] && [ -d "$omarchy_root" ]; then
    export NIXARCHY_ROOT="$omarchy_root"
    export OMARCHY_PATH="$omarchy_root"
    export PATH="$omarchy_root/bin:$PATH"
fi

if [ -x "$config_dir/run" ]; then
    exec "$config_dir/run"
fi

if "$qs_bin" --help 2>&1 | grep -q -- ' -p'; then
    exec "$qs_bin" -p "$config_dir"
fi

exec "$qs_bin" "$config_dir/shell.qml"
