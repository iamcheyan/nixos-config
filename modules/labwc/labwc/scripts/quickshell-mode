#!/bin/sh
set -eu

anchor_config_dir="${ANCHOR_SHELL_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/anchor-shell}"
legacy_config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell"
mode_file="$anchor_config_dir/mode"
runtime_file="$anchor_config_dir/runtime"
mkdir -p "$anchor_config_dir"
case "${1:-}" in
    dev|nix)
        mkdir -p "$(dirname "$mode_file")"
        printf '%s\n' "$1" > "$mode_file"
        ;;
    runtime)
        case "${2:-}" in
            compat|legacy)
                mkdir -p "$(dirname "$runtime_file")"
                printf '%s\n' "$2" > "$runtime_file"
                ;;
            *)
                printf 'Usage: %s runtime {compat|legacy}\n' "$0" >&2
                exit 2
                ;;
        esac
        ;;
    status)
        status_mode_file="$mode_file"
        status_runtime_file="$runtime_file"
        [ -r "$status_mode_file" ] || status_mode_file="$legacy_config_dir/mode"
        [ -r "$status_runtime_file" ] || status_runtime_file="$legacy_config_dir/runtime"
        if [ -r "$status_mode_file" ]; then
            printf 'Quickshell mode: %s\n' "$(cat "$status_mode_file")"
        else
            printf 'Quickshell mode: nix (default)\n'
        fi
        if [ -r "$status_runtime_file" ]; then
            printf 'Omarchy runtime: %s\n' "$(cat "$status_runtime_file")"
        else
            printf 'Omarchy runtime: legacy (default)\n'
        fi
        exit 0
        ;;
    *)
        printf 'Usage: %s {dev|nix|runtime {compat|legacy}|status}\n' "$0" >&2
        exit 2
        ;;
esac

# Labwc's autostart supervisor notices the exit and starts the selected root.
# The CLI's `--newest` selector is not accepted consistently across Quickshell
# versions, so resolve the actual PID first and stop exactly that instance.
if command -v quickshell >/dev/null 2>&1; then
    instance_pid="$(quickshell list --all 2>/dev/null | awk '/Process ID:/ {print $3; exit}')"
    case "$instance_pid" in
        ''|*[!0-9]*) ;;
        *) quickshell kill --pid "$instance_pid" >/dev/null 2>&1 || true ;;
    esac
fi

printf 'Quickshell mode set to %s; the shell is restarting.\n' "$1"
