#!/bin/sh
# Keep the desktop session command while making the session bridge
# owned by this repository.  Labwc and other standalone
# compositors need to publish their Wayland environment before user services
# such as Fcitx5 are restarted.

set -eu

[ -n "${WAYLAND_DISPLAY:-}" ] || exit 0

systemctl --user import-environment \
    WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP \
    XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS \
    QUICKSHELL_ROOT QUICKSHELL_PLUGINS_DIR QUICKSHELL_CONFIG \
    OMARCHY_PATH 2>/dev/null || true

for unit in omarchy-fcitx5.service fcitx5.service; do
    if systemctl --user cat "$unit" >/dev/null 2>&1; then
        systemctl --user restart --no-block "$unit" || true
        break
    fi
done
