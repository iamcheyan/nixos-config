#!/bin/sh
set -eu

image=${1:?Usage: set-wallpaper-image IMAGE}
[ -f "$image" ] || exit 1
image=$(realpath -- "$image")

export WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

state_dir="${ANCHOR_SHELL_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/anchor-shell}"
mkdir -p "$state_dir"
printf '%s\n' "$image" > "$state_dir/wallpaper"

# Publish the same choice for the next SDDM greeter when the private helper
# is deployed. On systems without Shizuka this remains a no-op.
if command -v sync-wallpaper-to-sddm >/dev/null 2>&1; then
  sync-wallpaper-to-sddm || true
fi

# Replace the current background and retain the choice for the next login.
for pid in $(pgrep -x wbg 2>/dev/null || true); do
	kill "$pid" 2>/dev/null || true
done
wbg "$image" >/dev/null 2>&1 &
