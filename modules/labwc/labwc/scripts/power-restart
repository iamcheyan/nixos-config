#!/bin/sh
# Quick restart menu — fuzzel

choice=$(printf "Restart labwc\nRestart quickshell" | fuzzel --dmenu \
    --hide-prompt \
    --prompt "  Restart: " \
    --anchor center \
    --width 22 \
    --lines 2)

case "$choice" in
    "Restart labwc")  labwc -r ;;
    "Restart quickshell")
        "$HOME/.config/labwc/scripts/restart-anchor-shell"
        ;;
    *)                exit 0 ;;
esac
