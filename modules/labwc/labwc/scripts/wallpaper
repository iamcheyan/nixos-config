#!/bin/sh
# Wallpaper picker — list images from ~/wallpapers and apply

BG_DIR="$HOME/wallpapers"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/labwc"
STATE_FILE="$STATE_DIR/wallpaper"

[ -d "$BG_DIR" ] || {
    notify-send -u normal "Wallpaper" "No wallpapers directory found in ~/wallpapers"
    exit 1
}

# Build file list
files=""
for f in "$BG_DIR"/*; do
    case "$f" in
        *.png|*.jpg|*.jpeg|*.webp|*.bmp)
            [ -f "$f" ] && files="${files}$(basename "$f")\n"
            ;;
    esac
done

[ -z "$files" ] && {
    notify-send -u normal "Wallpaper" "No images found in ~/wallpapers"
    exit 1
}

chosen=$(printf '%b' "$files" | wofi --dmenu \
    -p "Wallpaper" -W 300 -H 300 -l 8 -i)

[ -z "$chosen" ] && exit 0

chosen_path="$BG_DIR/$chosen"
[ -f "$chosen_path" ] || exit 0

# Persist the selection for the next Labwc login, then apply it.
mkdir -p "$STATE_DIR"
printf '%s\n' "$chosen_path" > "$STATE_FILE"
for _pid in $(ps -eo pid=,comm= | awk '$2 ~ /swaybg/ {print $1}'); do
	[ "$_pid" = "$$" ] || kill "$_pid" 2>/dev/null || true
done
swaybg -i "$chosen_path" -m fill >/dev/null 2>&1 &
_bg_pid=$!
disown "$_bg_pid" 2>/dev/null || true
