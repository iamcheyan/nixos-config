#!/bin/sh
# Brightness control via Fuzzel

cur=$(brightnessctl -m | awk -F, '{print $4}' | tr -d '%')

opts=$(printf '%s\n' \
    "10%" "25%" "50%" "75%" "100%" \
    "Brightness -10" \
    "Brightness +10")

chosen=$(printf '%s\n' "$opts" | fuzzel --dmenu \
    --prompt "Brightness (current: ${cur}%)" \
    --width 36 --lines 7 --no-icons)

[ -z "$chosen" ] && exit 0

case "$chosen" in
    "Brightness -10") brightnessctl set 10%- ;;
    "Brightness +10") brightnessctl set 10%+ ;;
    *) brightnessctl set "${chosen}" ;;
esac
