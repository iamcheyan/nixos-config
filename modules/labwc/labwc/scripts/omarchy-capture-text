#!/usr/bin/env bash
set -euo pipefail

selection="$(slurp 2>/dev/null)" || exit 0
[[ -n "$selection" ]] || exit 0
text="$(grim -g "$selection" - | tesseract stdin stdout --oem 1 --psm 6 -l "${OMARCHY_OCR_LANGS:-eng}" --dpi 300 -c preserve_interword_spaces=1 2>/dev/null)" || exit 1
[[ -n "$text" ]] || exit 1
printf '%s' "$text" | wl-copy
notify-send "OCR" "Text copied to clipboard" 2>/dev/null || true
