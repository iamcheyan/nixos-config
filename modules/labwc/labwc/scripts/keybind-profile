#!/bin/sh
# keybind-profile — assemble rc.xml from environment-specific keybind snippets
set -eu

config_dir="$HOME/.config/labwc"
rc_file="$config_dir/rc.xml"
kb_dir="$config_dir/keybinds"
state_file="$config_dir/.keybind-profile"

# Detect environment
detect_env() {
    # Check WSL
    if [ -n "${WSL_DISTRO_NAME:-}" ] || [ -n "${WSL_INTEROP:-}" ] || [ -n "${WSLENV:-}" ]; then
        echo "wsl"; return
    fi
    if [ -r /proc/version ] && grep -qiE 'microsoft|wsl' /proc/version 2>/dev/null; then
        echo "wsl"; return
    fi

    # Check keyboard profile (mac-jis = Mac keyboard)
    if [ -r "$config_dir/.keyboard-profile" ]; then
        case "$(cat "$config_dir/.keyboard-profile")" in
            mac-jis) echo "mac-jis"; return ;;
        esac
    fi

    echo "linux"
}

env="${1:-$(detect_env)}"

# Validate
if [ ! -f "$kb_dir/$env.xml" ]; then
    echo "Unknown keybind profile: $env (available: $(ls "$kb_dir"/*.xml 2>/dev/null | xargs -I{} basename {} .xml | tr '\n' ' '))" >&2
    exit 2
fi

# Assemble rc.xml
cat > "$rc_file" << HEADER
<?xml version="1.0" encoding="UTF-8"?>

<labwc_config>

  <core>
    <gap>3</gap>
  </core>

  <theme>
    <name>BL-Lithium-dark</name>
    <cornerRadius>0</cornerRadius>
    <maximizedDecoration>none</maximizedDecoration>

    <font place="ActiveWindow" name="MesloLGS NF" size="9" />
    <font place="InactiveWindow" name="MesloLGS NF" size="9" />
    <font place="MenuItem" name="MesloLGS NF" size="9" />

    <font place="OnScreenDisplay">
      <name>MesloLGS NF</name>
      <size>11</size>
      <weight>normal</weight>
    </font>
  </theme>

  <desktops number="4">
    <popupTime>800</popupTime>
  </desktops>

  <windowSwitcher>
    <osd show="yes" style="thumbnail" preview="yes" outlines="yes" output="cursor"
      thumbnailLabelFormat="%W — %T" />
    <fields>
      <field content="icon" width="15%" />
      <field content="title" width="85%" />
    </fields>
  </windowSwitcher>

  <keyboard>
    <!-- ⚠️ 此文件由 keybind-profile 脚本自动生成，请勿直接编辑！ -->
    <!-- 修改快捷键请编辑: ~/.config/labwc/keybinds/ 下的 xml 文件 -->
    <default />
HEADER

cat "$kb_dir/$env.xml" >> "$rc_file"

cat >> "$rc_file" << 'FOOTER'

    <!-- 通用: 键盘切换 -->
    <keybind key="A-S-k">
      <action name="Execute" command="~/.config/labwc/scripts/keyboard-profile next" />
    </keybind>

    <!-- Standard Omarchy-compatible lock shortcut. -->
    <keybind key="W-C-l">
      <action name="Execute" command="~/.config/labwc/scripts/lock-screen" />
    </keybind>

    <!-- 通用: 窗口切换 -->
    <keybind key="A-Tab">
      <action name="NextWindow" workspace="all" output="all" />
    </keybind>
    <keybind key="A-S-Tab">
      <action name="PreviousWindow" workspace="all" output="all" />
    </keybind>
    <keybind key="C-Tab">
      <action name="NextWindow" />
    </keybind>
    <keybind key="C-S-Tab">
      <action name="PreviousWindow" />
    </keybind>

    <!-- 通用: 工作区切换 -->
    <keybind key="A-Left">
      <action name="GoToDesktop" to="left" wrap="yes" />
    </keybind>
    <keybind key="A-Right">
      <action name="GoToDesktop" to="right" wrap="yes" />
    </keybind>
    <keybind key="W-1">
      <action name="GoToDesktop" to="1" />
    </keybind>
    <keybind key="W-2">
      <action name="GoToDesktop" to="2" />
    </keybind>
    <keybind key="W-3">
      <action name="GoToDesktop" to="3" />
    </keybind>
    <keybind key="W-4">
      <action name="GoToDesktop" to="4" />
    </keybind>
    <keybind key="W-S-1">
      <action name="SendToDesktop" to="1" follow="no" />
    </keybind>
    <keybind key="W-S-2">
      <action name="SendToDesktop" to="2" follow="no" />
    </keybind>
    <keybind key="W-S-3">
      <action name="SendToDesktop" to="3" follow="no" />
    </keybind>
    <keybind key="W-S-4">
      <action name="SendToDesktop" to="4" follow="no" />
    </keybind>

    <!-- 通用: 截图 -->
    <keybind key="Print">
      <action name="Execute" command="~/.config/labwc/scripts/omarchy-capture-screenshot smart slurp" />
    </keybind>
    <keybind key="A-Print">
      <action name="Execute" command="~/.config/labwc/scripts/omarchy-capture-screenshot fullscreen save" />
    </keybind>
    <keybind key="S-Print">
      <action name="Execute" command="~/.config/labwc/scripts/omarchy-delayed-screenshot 3 fullscreen" />
    </keybind>
    <keybind key="C-S-Print">
      <action name="If">
        <query><monitor>HDMI-A-1</monitor></query>
        <then><action name="Execute" command="nixarchy-screenshot-active-monitor HDMI-A-1" /></then>
        <else>
          <action name="If">
            <query><monitor>HDMI-A-2</monitor></query>
            <then><action name="Execute" command="nixarchy-screenshot-active-monitor HDMI-A-2" /></then>
            <else><action name="Execute" command="nixarchy-screenshot-active-monitor" /></else>
          </action>
        </else>
      </action>
    </keybind>
    <keybind key="W-S-a">
      <action name="Execute" command="~/.config/labwc/scripts/omarchy-capture-screenshot region copy" />
    </keybind>

    <!-- 通用: 亮度 -->
    <keybind key="XF86MonBrightnessUp">
      <action name="Execute" command="~/.config/labwc/scripts/brightness-control up" />
    </keybind>
    <keybind key="XF86MonBrightnessDown">
      <action name="Execute" command="~/.config/labwc/scripts/brightness-control down" />
    </keybind>

    <!-- 通用: 音量 -->
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute" command="sh -c 'pactl set-sink-volume @DEFAULT_SINK@ +2% &amp;&amp; quickshell -p ~/.config/quickshell/labwc ipc call volume-helper triggerUpdate'" />
    </keybind>
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute" command="sh -c 'pactl set-sink-volume @DEFAULT_SINK@ -2% &amp;&amp; quickshell -p ~/.config/quickshell/labwc ipc call volume-helper triggerUpdate'" />
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute" command="sh -c 'pactl set-sink-mute @DEFAULT_SINK@ toggle &amp;&amp; quickshell -p ~/.config/quickshell/labwc ipc call volume-helper triggerUpdate'" />
    </keybind>

  </keyboard>

  <mouse>
    <default />
    <context name="Frame">
      <mousebind button="A-Left" action="Drag">
        <action name="Move" />
      </mousebind>
    </context>
    <context name="Root">
      <mousebind button="Right" action="Press">
        <action name="ShowMenu" menu="root-menu" />
      </mousebind>
    </context>
  </mouse>

  <windowRules>
    <windowRule identifier="wofi" skipTaskbar="yes" skipWindowSwitcher="yes">
      <action name="ToggleAlwaysOnTop" />
      <action name="Raise" />
      <action name="Focus" />
    </windowRule>
    <windowRule identifier="*kitty*">
      <titlebarColor>#000000</titlebarColor>
      <titlebarTextColor>#ffffff</titlebarTextColor>
    </windowRule>
    <windowRule identifier="*alacritty*">
      <titlebarColor>#000000</titlebarColor>
      <titlebarTextColor>#ffffff</titlebarTextColor>
    </windowRule>
    <windowRule identifier="*alacrtty*">
      <titlebarColor>#000000</titlebarColor>
      <titlebarTextColor>#ffffff</titlebarTextColor>
    </windowRule>
    <windowRule identifier="*kwrite*">
      <titlebarColor>#808080</titlebarColor>
      <titlebarTextColor>#ffffff</titlebarTextColor>
    </windowRule>
    <!-- Test forced SSD on CSD apps -->
    <windowRule identifier="*code*">
      <serverDecoration>yes</serverDecoration>
      <titlebarColor>#1e1e1e</titlebarColor>
      <titlebarTextColor>#cccccc</titlebarTextColor>
    </windowRule>
    <windowRule identifier="*firefox*">
      <serverDecoration>yes</serverDecoration>
      <titlebarColor>#1e1e1e</titlebarColor>
      <titlebarTextColor>#cccccc</titlebarTextColor>
    </windowRule>
    <windowRule identifier="*chrome*">
      <serverDecoration>yes</serverDecoration>
      <titlebarColor>#1e1e1e</titlebarColor>
      <titlebarTextColor>#cccccc</titlebarTextColor>
    </windowRule>
  </windowRules>

  <hotCorner>
    <topLeft x="1" y="1">
      <action name="GoToDesktop" to="left" wrap="yes" />
    </topLeft>
    <topRight x="1" y="1">
      <action name="ShowMenu" menu="root-menu" />
    </topRight>
  </hotCorner>
</labwc_config>
FOOTER

echo "$env" > "$state_file"
echo "Keybind profile: $env → $rc_file"

if [ "$env" = "wsl" ]; then
    "$config_dir/scripts/wsl-config" >/dev/null
fi

# Reload labwc if running
if pid="$(pgrep -n -x labwc-dev 2>/dev/null)" || pid="$(pgrep -n -x labwc-plus 2>/dev/null)" || pid="$(pgrep -n -x labwc 2>/dev/null)"; then
    kill -HUP "$pid" 2>/dev/null && echo "labwc reloaded (PID $pid)"
fi

command -v notify-send >/dev/null 2>&1 &&
    notify-send "Keybind profile" "$env" 2>/dev/null || true
