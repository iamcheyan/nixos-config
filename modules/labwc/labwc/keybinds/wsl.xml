    <!-- WSL: 标准键位，无交换 -->

    <!-- 基础启动 -->
    <keybind key="A-Return">
      <action name="Execute" command="alacritty" />
    </keybind>

    <keybind key="A-d">
      <action name="Execute" command="~/.config/labwc/scripts/launcher" />
    </keybind>

    <keybind key="A-space">
      <action name="ShowMenu" menu="root-menu" />
    </keybind>

    <keybind key="A-q">
      <action name="Close" />
    </keybind>

    <keybind key="A-f">
      <action name="ToggleFullscreen" />
    </keybind>

    <keybind key="A-m">
      <action name="ToggleMaximize" />
    </keybind>

    <!-- Omarchy-compatible universal clipboard -->
    <keybind key="W-c">
      <action name="Execute" command="~/.config/labwc/scripts/universal-clipboard copy" />
    </keybind>
    <keybind key="W-v">
      <action name="Execute" command="~/.config/labwc/scripts/universal-clipboard paste" />
    </keybind>
    <keybind key="W-x">
      <action name="Execute" command="~/.config/labwc/scripts/universal-clipboard cut" />
    </keybind>


    <!-- Voxtype voice input -->
    <keybind key="A-a">
      <action name="Execute" command="voxtype record toggle" />
    </keybind>
    <keybind key="F9">
      <action name="Execute" command="voxtype record toggle" />
    </keybind>
    <keybind key="F24" onRelease="yes">
      <action name="Execute" command="voxtype record toggle" />
    </keybind>
    <!-- 截图 -->
