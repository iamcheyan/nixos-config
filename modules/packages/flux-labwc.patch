--- i/internal/core/remotedesktop.go
+++ w/internal/core/remotedesktop.go
@@ -178 +178,54 @@ func cpuRecorder(path string) recorder {
-	return recorder{desktopCPURecorder, path, hyprMonitors, cpuRecorderArgs}
+	list := hyprMonitors
+	if labwcSession() {
+		list = labwcMonitors
+	}
+	return recorder{desktopCPURecorder, path, list, cpuRecorderArgs}
+}
+
+func labwcSession() bool {
+	for _, desktop := range strings.Split(os.Getenv("XDG_CURRENT_DESKTOP"), ":") {
+		if strings.EqualFold(desktop, "labwc") {
+			return true
+		}
+	}
+	return strings.EqualFold(os.Getenv("XDG_SESSION_DESKTOP"), "labwc")
+}
+
+// labwcMonitors reads active outputs from the wlroots wlr-randr utility.
+func labwcMonitors(ctx context.Context) ([]monitor, error) {
+	ctx, cancel := context.WithTimeout(ctx, 3*time.Second)
+	defer cancel()
+	out, err := exec.CommandContext(ctx, "wlr-randr").Output()
+	if err != nil {
+		return nil, fmt.Errorf("list Labwc outputs with wlr-randr: %w", err)
+	}
+	var ms []monitor
+	var name string
+	var enabled bool
+	var width, height int
+	flush := func() {
+		if name != "" && enabled && width > 0 && height > 0 {
+			ms = append(ms, monitor{name, width, height})
+		}
+	}
+	for _, line := range strings.Split(string(out), "\\n") {
+		if !strings.HasPrefix(line, " ") && strings.TrimSpace(line) != "" {
+			flush()
+			name = strings.Fields(line)[0]
+			enabled = false
+			width, height = 0, 0
+			continue
+		}
+		trimmed := strings.TrimSpace(line)
+		if trimmed == "Enabled: yes" {
+			enabled = true
+		}
+		if strings.Contains(trimmed, " px,") && strings.Contains(trimmed, "current") {
+			fmt.Sscanf(trimmed, "%dx%d", &width, &height)
+		}
+	}
+	flush()
+	if len(ms) == 0 {
+		return nil, errors.New("Labwc has no enabled output to capture")
+	}
+	return ms, nil
@@ -187,0 +241,6 @@ func pickRecorder(ctx context.Context, lookPath func(string) (string, error)) (r
+	if labwcSession() {
+		if cpuErr != nil {
+			return recorder{}, errors.New("Labwc remote desktop needs wf-recorder")
+		}
+		return cpuRecorder(cpu), nil
+	}
@@ -300,0 +360,3 @@ func wakeDisplays(ctx context.Context) error {
+	if labwcSession() {
+		return nil
+	}
@@ -310,0 +373,56 @@ func focusedMonitor(ctx context.Context) string {
+	if labwcSession() {
+		// Match the pointer to wlr-randr output geometry. This mirrors the
+		// output selection used by Anchor Shell's Labwc screenshot action.
+		location, err := exec.CommandContext(ctx, "xdotool", "getmouselocation", "--shell").Output()
+		if err != nil {
+			return ""
+		}
+		var px, py int
+		for _, line := range strings.Split(string(location), "\\n") {
+			if strings.HasPrefix(line, "X=") {
+				fmt.Sscanf(line, "X=%d", &px)
+			}
+			if strings.HasPrefix(line, "Y=") {
+				fmt.Sscanf(line, "Y=%d", &py)
+			}
+		}
+		out, err := exec.CommandContext(ctx, "wlr-randr").Output()
+		if err != nil {
+			return ""
+		}
+		var name string
+		var x, y, w, h int
+		scale := 1.0
+		enabled := false
+		found := ""
+		flush := func() {
+			if enabled && w > 0 && h > 0 && float64(px) >= float64(x) && float64(px) < float64(x)+float64(w)/scale && float64(py) >= float64(y) && float64(py) < float64(y)+float64(h)/scale {
+				found = name
+			}
+		}
+		for _, line := range strings.Split(string(out), "\\n") {
+			if !strings.HasPrefix(line, " ") && strings.TrimSpace(line) != "" {
+				flush()
+				name = strings.Fields(line)[0]
+				x, y, w, h = 0, 0, 0, 0
+				scale = 1
+				enabled = false
+				continue
+			}
+			t := strings.TrimSpace(line)
+			if t == "Enabled: yes" {
+				enabled = true
+			}
+			if strings.Contains(t, " px,") && strings.Contains(t, "current") {
+				fmt.Sscanf(t, "%dx%d", &w, &h)
+			}
+			if strings.HasPrefix(t, "Position:") {
+				fmt.Sscanf(t, "Position: %d,%d", &x, &y)
+			}
+			if strings.HasPrefix(t, "Scale:") {
+				fmt.Sscanf(t, "Scale: %f", &scale)
+			}
+		}
+		flush()
+		return found
+	}
