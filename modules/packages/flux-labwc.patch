@@ -373,0 +385,225 @@ func (d *Daemon) shortcutState(list bool) (map[string]any, error) {
+
+type labwcKeybind struct {
+	Key     string `xml:"key,attr"`
+	Actions []struct {
+		Name    string `xml:"name,attr"`
+		To      string `xml:"to,attr"`
+		Command string `xml:"command,attr"`
+	} `xml:"action"`
+}
+type labwcConfig struct {
+	Keybinds []labwcKeybind `xml:"keyboard>keybind"`
+	Desktops struct {
+		Number int `xml:"number,attr"`
+	} `xml:"desktops"`
+}
+
+func readLabwcConfig() (labwcConfig, error) {
+	path := filepath.Join(os.Getenv("HOME"), ".config/labwc/rc.xml")
+	b, err := os.ReadFile(path)
+	if err != nil {
+		return labwcConfig{}, fmt.Errorf("read Labwc configuration: %w", err)
+	}
+	var c labwcConfig
+	if err := xml.Unmarshal(b, &c); err != nil {
+		return c, fmt.Errorf("parse Labwc configuration: %w", err)
+	}
+	if c.Desktops.Number < 1 || c.Desktops.Number > maxWorkspace {
+		c.Desktops.Number = 4
+	}
+	return c, nil
+}
+
+func labwcModifiers(key string) ([]string, string) {
+	parts := strings.Split(key, "-")
+	mods := []string{}
+	for len(parts) > 1 {
+		switch strings.ToUpper(parts[0]) {
+		case "W":
+			mods = append(mods, "logo")
+		case "A":
+			mods = append(mods, "alt")
+		case "C":
+			mods = append(mods, "ctrl")
+		case "S":
+			mods = append(mods, "shift")
+		default:
+			return nil, ""
+		}
+		parts = parts[1:]
+	}
+	if len(parts) != 1 || parts[0] == "" {
+		return nil, ""
+	}
+	return mods, parts[0]
+}
+
+func labwcShortcutList(c labwcConfig) []Shortcut {
+	out := []Shortcut{}
+	for i, b := range c.Keybinds {
+		mods, key := labwcModifiers(b.Key)
+		if key == "" {
+			continue
+		}
+		labels := []string{}
+		for _, a := range b.Actions {
+			label := a.Name
+			if label == "Execute" && a.Command != "" {
+				label = a.Command
+			}
+			if label != "" {
+				labels = append(labels, label)
+			}
+		}
+		if len(labels) == 0 {
+			continue
+		}
+		out = append(out, Shortcut{Ref: strconv.Itoa(i + 1), Keys: strings.ToUpper(strings.Join(append(mods, key), " ")), Description: strings.Join(labels, ", ")})
+	}
+	return out
+}
+
+func labwcWorkspaceFiles() ([]string, error) {
+	runtime := os.Getenv("XDG_RUNTIME_DIR")
+	if runtime == "" {
+		return nil, errors.New("XDG_RUNTIME_DIR is not set")
+	}
+	files, err := filepath.Glob(filepath.Join(runtime, "labwc", "workspace-*"))
+	if err != nil {
+		return nil, err
+	}
+	var outputs []string
+	for _, f := range files {
+		if strings.HasSuffix(f, ".goto") {
+			continue
+		}
+		outputs = append(outputs, f)
+	}
+	sort.Strings(outputs)
+	if len(outputs) == 0 {
+		return nil, errors.New("Labwc workspace state is not available")
+	}
+	return outputs, nil
+}
+
+func labwcActiveWorkspace() (int, int, string, error) {
+	files, err := labwcWorkspaceFiles()
+	if err != nil {
+		return 0, 0, "", err
+	}
+	output := focusedMonitor(context.Background())
+	selected := files[0]
+	for _, f := range files {
+		if output != "" && strings.TrimPrefix(f, filepath.Dir(f)+"/workspace-") == output {
+			selected = f
+			break
+		}
+	}
+	b, err := os.ReadFile(selected)
+	if err != nil {
+		return 0, 0, "", err
+	}
+	var current, count int
+	if _, err := fmt.Sscanf(string(b), "%d %d", &current, &count); err != nil || current < 1 || count < 1 {
+		return 0, 0, "", errors.New("invalid Labwc workspace state")
+	}
+	return current, count, selected, nil
+}
+
+func labwcShortcutState(list bool) (map[string]any, error) {
+	c, err := readLabwcConfig()
+	if err != nil {
+		return nil, err
+	}
+	active, count, _, err := labwcActiveWorkspace()
+	if err != nil {
+		return nil, err
+	}
+	workspaces := make([]Workspace, count)
+	for i := range workspaces {
+		workspaces[i] = Workspace{ID: i + 1}
+	}
+	body := map[string]any{"workspaces": workspaces, "active": active}
+	if list {
+		body["shortcuts"] = labwcShortcutList(c)
+	}
+	return body, nil
+}
+
+func writeLabwcWorkspace(id int) error {
+	active, count, state, err := labwcActiveWorkspace()
+	_ = active
+	if err != nil {
+		return err
+	}
+	if id < 1 || id > count {
+		return fmt.Errorf("workspace %d is not from 1 to %d", id, count)
+	}
+	request := state + ".goto"
+	tmp := request + ".tmp-" + strconv.Itoa(os.Getpid())
+	if err := os.WriteFile(tmp, []byte(strconv.Itoa(id)+"\\n"), 0600); err != nil {
+		return err
+	}
+	return os.Rename(tmp, request)
+}
+
+func labwcBindingForAction(c labwcConfig, name string, to string) (string, bool) {
+	for _, b := range c.Keybinds {
+		for _, a := range b.Actions {
+			if a.Name == name && (to == "" || a.To == to) {
+				return b.Key, true
+			}
+		}
+	}
+	return "", false
+}
+
+func pressLabwcBinding(ctx context.Context, key string) error {
+	mods, name := labwcModifiers(key)
+	if name == "" {
+		return fmt.Errorf("unsupported Labwc key binding %s", peerText(key))
+	}
+	return (desktop.Keyboard{}).Key(ctx, name, mods)
+}
+
+func (d *Daemon) runLabwcShortcut(ctx context.Context, b shortcutBody) error {
+	c, err := readLabwcConfig()
+	if err != nil {
+		return err
+	}
+	if b.Run != "" {
+		idx, err := strconv.Atoi(b.Run)
+		if err != nil || idx < 1 || idx > len(c.Keybinds) {
+			return errors.New("the shortcut is gone. Labwc read its configuration again")
+		}
+		key := c.Keybinds[idx-1].Key
+		if _, name := labwcModifiers(key); name == "" {
+			return errors.New("this Labwc shortcut cannot be sent remotely")
+		}
+		return pressLabwcBinding(ctx, key)
+	}
+	if b.Action == "workspace" {
+		return writeLabwcWorkspace(b.Workspace)
+	}
+	if b.Action == "moveToWorkspace" {
+		key, ok := labwcBindingForAction(c, "SendToDesktop", strconv.Itoa(b.Workspace))
+		if !ok {
+			return fmt.Errorf("Labwc has no key binding to move a window to workspace %d", b.Workspace)
+		}
+		return pressLabwcBinding(ctx, key)
+	}
+	actions := map[string]string{"close": "Close", "fullscreen": "ToggleFullscreen", "nextWindow": "NextWindow", "nextWorkspace": "GoToDesktop"}
+	name, ok := actions[b.Action]
+	if !ok {
+		return fmt.Errorf("the action %s is not supported by Labwc", peerText(b.Action))
+	}
+	to := ""
+	if b.Action == "nextWorkspace" {
+		to = "right"
+	}
+	key, ok := labwcBindingForAction(c, name, to)
+	if !ok {
+		return fmt.Errorf("Labwc has no key binding for %s", name)
+	}
+	return pressLabwcBinding(ctx, key)
+}
